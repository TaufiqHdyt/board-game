{
	"name": "@bg/web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --port 5173",
		"dev:host": "vite dev --port 5173 --host",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --persist-to ../../.wrangler/state",
		"deploy": "pnpm build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"types": "wrangler types"
	},
	"dependencies": {
		"@bg/db": "workspace:*",
		"@bg/game": "workspace:*",
		"@bg/proto": "workspace:*",
		"drizzle-orm": "^0.45.4",
		"partysocket": "^1.3.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.160.0"
	}
}
