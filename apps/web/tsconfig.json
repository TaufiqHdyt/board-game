{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// `wrangler types` references the built worker once it exists; without
		// this, `pnpm check` after `pnpm build` would type-check build output.
		"checkJs": false,
		"types": [
			"$app/types",
			"./worker-configuration.d.ts"
		]
	},
	"include": ["src", "vite.config.ts"]
}
