{
	"name": "@bg/realtime",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --port 8787 --persist-to ../../.wrangler/state",
		"dev:host": "wrangler dev --port 8787 --ip 0.0.0.0 --persist-to ../../.wrangler/state",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"types": "wrangler types --env-file .dev.vars.example",
		"check": "wrangler types --env-file .dev.vars.example && tsc -p tsconfig.json",
		"db:migrate:local": "wrangler d1 migrations apply board-game --local --persist-to ../../.wrangler/state",
		"db:migrate:remote": "wrangler d1 migrations apply board-game --remote"
	},
	"dependencies": {
		"@bg/db": "workspace:*",
		"@bg/game": "workspace:*",
		"@bg/proto": "workspace:*",
		"drizzle-orm": "^0.45.4"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"vitest": "^5.1.0",
		"wrangler": "^4.160.0"
	}
}
